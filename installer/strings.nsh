; Framework-provided language files translate standard buttons, pages, errors
; and uninstall prompts. Every HolyBear-specific string is translated here.
LangString ChooseLanguage ${LANG_ENGLISH} "Select the installer language:"
LangString ChooseLanguage ${LANG_TRADCHINESE} "請選擇安裝程式語言："
LangString ChooseLanguage ${LANG_SIMPCHINESE} "请选择安装程序语言："
LangString WelcomeText ${LANG_ENGLISH} "Install ${TITLE} for your Windows account.$\r$\n$\r$\nThis unofficial community edition includes all menu resources and languages. Microsoft Edge WebView2 Runtime is required for F1 settings.$\r$\n$\r$\nExisting HolyBear settings are preserved during upgrades. The original NitLink installation is separate."
LangString WelcomeText ${LANG_TRADCHINESE} "為目前的 Windows 帳戶安裝 ${TITLE}。$\r$\n$\r$\n本非官方社群版本包含完整介面與語言資源。F1 設定介面需要 Microsoft Edge WebView2 Runtime。$\r$\n$\r$\n升級會保留既有 HolyBear 設定，並與原本的 NitLink 安裝版本分開。"
LangString WelcomeText ${LANG_SIMPCHINESE} "为当前 Windows 账户安装 ${TITLE}。$\r$\n$\r$\n本非官方社区版本包含完整界面与语言资源。F1 设置界面需要 Microsoft Edge WebView2 Runtime。$\r$\n$\r$\n升级会保留已有 HolyBear 设置，并与原来的 NitLink 安装版本分开。"
LangString CoreName ${LANG_ENGLISH} "NitLink and required resources"
LangString CoreName ${LANG_TRADCHINESE} "NitLink 與必要資源"
LangString CoreName ${LANG_SIMPCHINESE} "NitLink 与必要资源"
LangString CoreDescription ${LANG_ENGLISH} "Application, F1 menu, three languages, runtime DLLs, licenses and Start menu shortcuts."
LangString CoreDescription ${LANG_TRADCHINESE} "主程式、F1 選單、三種語言、執行時 DLL、授權文件及開始功能表捷徑。"
LangString CoreDescription ${LANG_SIMPCHINESE} "主程序、F1 菜单、三种语言、运行时 DLL、许可文件和开始菜单快捷方式。"
LangString DesktopName ${LANG_ENGLISH} "Desktop shortcut"
LangString DesktopName ${LANG_TRADCHINESE} "桌面捷徑"
LangString DesktopName ${LANG_SIMPCHINESE} "桌面快捷方式"
LangString DesktopDescription ${LANG_ENGLISH} "Add a shortcut to your desktop (optional)."
LangString DesktopDescription ${LANG_TRADCHINESE} "在桌面建立捷徑（選用）。"
LangString DesktopDescription ${LANG_SIMPCHINESE} "在桌面创建快捷方式（可选）。"
LangString LaunchText ${LANG_ENGLISH} "Launch ${PRODUCT}"
LangString LaunchText ${LANG_TRADCHINESE} "啟動 ${PRODUCT}"
LangString LaunchText ${LANG_SIMPCHINESE} "启动 ${PRODUCT}"
LangString UninstallShortcut ${LANG_ENGLISH} "Uninstall HolyBear Edition"
LangString UninstallShortcut ${LANG_TRADCHINESE} "解除安裝 HolyBear Edition"
LangString UninstallShortcut ${LANG_SIMPCHINESE} "卸载 HolyBear Edition"
LangString UninstallWelcome ${LANG_ENGLISH} "Remove ${PRODUCT}.$\r$\n$\r$\nYour settings, screenshots and other generated files will be kept. No user data is deleted. Close NitLink before continuing."
LangString UninstallWelcome ${LANG_TRADCHINESE} "移除 ${PRODUCT}。$\r$\n$\r$\n您的設定、截圖及其他產生的檔案都會保留，不會刪除使用者資料。請先關閉 NitLink 再繼續。"
LangString UninstallWelcome ${LANG_SIMPCHINESE} "移除 ${PRODUCT}。$\r$\n$\r$\n您的设置、截图和其他生成的文件都会保留，不会删除用户数据。请先关闭 NitLink 再继续。"
LangString UninstallFinish ${LANG_ENGLISH} "${PRODUCT} has been removed.$\r$\n$\r$\nAny user settings and screenshots remain in the installation folder."
LangString UninstallFinish ${LANG_TRADCHINESE} "${PRODUCT} 已解除安裝。$\r$\n$\r$\n使用者設定及截圖仍保留在原安裝資料夾。"
LangString UninstallFinish ${LANG_SIMPCHINESE} "${PRODUCT} 已卸载。$\r$\n$\r$\n用户设置和截图仍保留在原安装文件夹。"
LangString NeedX64 ${LANG_ENGLISH} "This edition requires 64-bit Windows."
LangString NeedX64 ${LANG_TRADCHINESE} "此版本需要 64 位元 Windows。"
LangString NeedX64 ${LANG_SIMPCHINESE} "此版本需要 64 位 Windows。"
LangString NeedWindows ${LANG_ENGLISH} "This edition requires Windows 10 version 1809 or later, or Windows 11."
LangString NeedWindows ${LANG_TRADCHINESE} "此版本需要 Windows 10 1809 或更新版本，或 Windows 11。"
LangString NeedWindows ${LANG_SIMPCHINESE} "此版本需要 Windows 10 1809 或更新版本，或 Windows 11。"
