// app.rc: Windows resource definitions for NitLink.
//
// This file is compiled by the MSVC resource compiler (rc.exe) into a .res
// object that gets linked into the final .exe. The result: the icon shows
// up everywhere Windows looks for an .exe icon (File Explorer, taskbar,
// alt-tab, the title bar of any window registered with this class) even
// before the app's WinMain runs.
//
// The path is relative to this file's location (src/). The actual .ico
// must exist at assets/nitlink.ico in the project root.

#include "resource.h"
#include <winres.h>

IDI_APP_ICON ICON "../assets/nitlink.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,3,0
 PRODUCTVERSION 1,2,3,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "NitLink"
            VALUE "FileVersion", "1.2.3"
            VALUE "InternalName", "NitLink"
            VALUE "LegalCopyright", "Copyright (c) 2026 NitLink Contributors"
            VALUE "OriginalFilename", "NitLink.exe"
            VALUE "ProductName", "NitLink"
            VALUE "ProductVersion", "1.2.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
